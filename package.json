{
  "name": "hunt-codes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">22"
  },
  "dependencies": {
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-three/fiber": "^9.7.0",
    "@tsparticles/confetti": "^4.4.0",
    "@tsparticles/plugin-interactivity": "4.4.0",
    "@tsparticles/ribbons": "^4.4.0",
    "@types/node": "^24.13.3",
    "@types/react-dom": "^19.2.4",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "lucide-react": "^1.30.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-feather": "^2.0.10",
    "react-router-dom": "^7.18.2",
    "sass": "^1.102.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tinycolor2": "^1.6.0",
    "tw-animate-css": "^1.4.0",
    "typed.js": "^2.1.0",
    "typescript": "^5.8.3",
    "use-debounce": "^10.1.1"
  },
  "resolutions": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "prepare": "husky",
    "start": "rsbuild dev",
    "build": "rsbuild build",
    "lint": "eslint src/**/*.{js,jsx,ts,tsx}",
    "knip": "knip",
    "serve": "serve -s build/",
    "deploy": "aws s3 sync build/ s3://hunt.codes --acl public-read --delete --exclude \"*.html\" --exclude \"robots.txt\" --exclude \"sitemap.xml\" --exclude \"site.webmanifest\" --exclude \"asset-manifest.json\" --cache-control \"public,max-age=31536000,immutable\" --profile andrew && aws s3 sync build/ s3://hunt.codes --acl public-read --exclude \"*\" --include \"*.html\" --include \"robots.txt\" --include \"sitemap.xml\" --include \"site.webmanifest\" --include \"asset-manifest.json\" --cache-control \"public,max-age=0,must-revalidate\" --profile andrew",
    "test": "bun test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "browserslist": [
    ">0.5%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.11.1",
    "@rsbuild/core": "^2.1.10",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-svgr": "^2.0.5",
    "@storybook/react": "^10.5.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/three": "^0.185.4",
    "@types/tinycolor2": "^1.4.6",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "knip": "^6.31.0",
    "storybook": "^10.5.6",
    "storybook-react-rsbuild": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.66.0"
  },
  "packageManager": "yarn@4.6.0"
}
