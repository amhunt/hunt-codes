{
  "permissions": {
    "deny": [
      "Bash(yarn deploy*)",
      "Bash(corepack yarn deploy*)",
      "Bash(./scripts/deploy.sh*)",
      "Bash(scripts/deploy.sh*)",
      "Bash(./server/deploy.sh*)",
      "Bash(server/deploy.sh*)",
      "Bash(aws *)",
      "Bash(wrangler deploy*)",
      "Bash(wrangler login*)",
      "Bash(npx wrangler deploy*)",
      "Bash(yarn wrangler deploy*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/Library/Preferences/.wrangler/**)",
      "Read(~/.config/.wrangler/**)",
      "Read(./.env*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/install_pkgs.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
